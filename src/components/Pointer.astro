---
// The pointer ▶ from the GARVIS logo (tall triangle, ratio ≈ 0.4). Colour comes from the context (currentColor / --pointer).
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<svg class:list={["ptr", cls]} viewBox="0 0 8 20" width="8" height="20" aria-hidden="true" focusable="false"><path d="M0 0L8 10L0 20Z" /></svg>
